model User {
  id       Int       @id @default(autoincrement())
  name     String
  email    String    @unique
  password String
  role     String    // "admin" or "member"
  articles Article[]
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
}
