<!DOCTYPE html>
<html>
<head>
    <title>User List</title>
</head>
<body>

    <h1>All Users</h1>

    <a href="/register">Register New User</a>

    <ul>
        <% if (users.length === 0) { %>
            <li>No users found</li>
        <% } else { %>
            <% users.forEach(user => { %>
                <li>
                    <%= user.name %> - <%= user.email %>
                </li>
            <% }) %>
        <% } %>
    </ul>

</body>
</html>
