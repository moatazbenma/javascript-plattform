<!DOCTYPE html>
<html>
<head>
    <title>Register User</title>
</head>
<body>

    <h1>Register User</h1>

    <form action="/submit" method="POST">
        <label>Name:</label>
        <input type="text" name="name" required><br>

        <label>Email:</label>
        <input type="email" name="email" required><br>

        <button type="submit">Save</button>
    </form>

</body>
</html>
